# ---- 运行产物 ----
# 每次仿真在 runs/ 下生成一个 SQLite 库与配套日志，不入库
runs/
*.db
*.db-shm
*.db-wal
*.live*.log

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/

# ---- 数据 ----
# data/cut/ 下的语料是随项目一起分发的，必须保留。
# 这里显式排除“忽略 JSON”的可能，避免以后误加规则把数据挡掉。
!data/cut/*.json
